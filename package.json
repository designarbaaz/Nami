{
  "name": "nami",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "setup:hosts": "powershell -ExecutionPolicy Bypass -File ./scripts/setup-hosts.ps1",
    "build": "next build",
    "build:live": "node --max-old-space-size=4096 ./node_modules/next/dist/bin/next build",
    "start": "next start --hostname 0.0.0.0",
    "start:live": "node --max-old-space-size=2048 ./node_modules/next/dist/bin/next start --hostname 0.0.0.0",
    "lint": "next lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "typescript": "^5.9.2"
  }
}
